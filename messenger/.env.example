# ---- Pflicht in Produktion ------------------------------------------------
PUBLIC_URL=https://chat.example.com
APP_SECRET=                     # mind. 32 zufällige Zeichen: openssl rand -hex 32
POSTGRES_PASSWORD=              # openssl rand -hex 24
SMTP_URL=smtps://user:pass@smtp.example.com:465   # E-Mail-Verifizierung & Passwort-Reset
MAIL_FROM="Adrian <no-reply@chat.example.com>"

# ---- Reverse Proxy / HTTPS ------------------------------------------------
DOMAIN=chat.example.com         # Caddy holt automatisch ein Let's-Encrypt-Zertifikat
TRUST_PROXY=true

# ---- Push (Web-Push / VAPID):  npx web-push generate-vapid-keys ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chat.example.com
# FCM (Android-App, optional): kompletter Service-Account-JSON in einer Zeile
FCM_SERVICE_ACCOUNT_JSON=

# ---- Anrufe: STUN/TURN -----------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp,turns:chat.example.com:5349?transport=tcp
TURN_SECRET=                    # openssl rand -hex 32 (gleicher Wert in coturn/turnserver.conf)

# ---- Speicher (Standard: lokales Volume; für Skalierung S3-kompatibel) ----
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3  S3_BUCKET=  S3_REGION=  S3_ENDPOINT=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=

# ---- Optional ---------------------------------------------------------------
# TURNSTILE_SECRET=             # Cloudflare Turnstile gegen automatisierte Registrierungen
# MAX_UPLOAD_MB=64
